# Copy to .env for local development. NEVER commit a real .env or secret key.
# Placeholders only -- replace the values, do not share them.
DJANGO_SECRET_KEY=your-secret-key-here
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# DATABASE_PATH is optional; only used to point at a scratch database for
# migration verification. Leave unset to use backend/db.sqlite3.
# DATABASE_PATH=/tmp/verify-db.sqlite3
